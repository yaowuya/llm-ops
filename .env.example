# Flask基础配置
FLASK_DEBUG=1
FLASK_ENV=development

# wtf配置
WTF_CSRF_ENABLED=False

# SQLAlchemy数据库配置
SQLALCHEMY_DATABASE_URI=postgresql://postgres:root@127.0.0.1:5432/llm-ops?client_encoding=utf8
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=True

# OpenAI服务提供者
OPENAI_API_KEY=

# HuggingFace接口配置
HUGGINGFACEHUB_API_TOKEN=
# Weaviate向量数据库配置
WEAVIATE_URL=
WEAVIATE_API_KEY=

# LangSmith配置
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=LLMOpsDev

# 百度地图
BAIDU_MAP_AK=
BAIDU_MAP_SK=

# 谷歌搜索
SERPER_API_KEY=
